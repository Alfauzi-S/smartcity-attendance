# Salin file ini menjadi .env lalu isi password database.
#   cp .env.example .env
# File .env bersifat rahasia (sudah masuk .gitignore); jangan di-commit.

# Alamat bind port host. 0.0.0.0 = semua interface (default).
# Di server ini diisi IP LAN supaya hanya pbo nginx proxy (10.1.201.3) yang
# bisa langsung menjangkau aplikasi dari luar.
APP_BIND_IP=0.0.0.0

# Port host yang dipublikasikan container "web".
# pbo nginx proxy meneruskan smartcity-unmul.web.id ke http://10.1.201.3:8090
# -> JANGAN memakai port yang sudah dipakai stack lain di server ini
#    (80, 443, 2201-2204, 8001-8004, 4431-4433, 3001, 3790, 7777, 8039).
APP_PORT=8090

# Identitas aplikasi. APP_BASE_URL dikosongkan = deteksi otomatis dari Host
# header (sudah benar saat berada di balik proxy, termasuk skema https).
APP_NAME=SmartCity Attendance
APP_BASE_URL=
APP_LOCALE=id
APP_TIMEZONE=Asia/Makassar
APP_TIMEZONE_LABEL=WITA
APP_DEBUG=false
APP_PRETTY_URLS=true

# Database (dipakai service "db" dan aplikasi).
# Password hanya dipakai saat database pertama kali dibuat; pada instalasi yang
# sudah berjalan, mengganti nilai di sini TIDAK mengubah user di dalam MariaDB.
DB_NAME=smartcity_attendance
DB_USER=smartcity
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sertifikat otomatis (lihat config/config.example.php). Nilai di bawah = bawaan.
CERT_MAX_UPLOAD_MB=8
CERT_BATCH_SIZE=10
CERT_SEARCH_PER_10MIN=30
CERT_DOWNLOAD_FAIL_PER_15MIN=8
